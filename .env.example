# This GitHub Pages version is fully static.
# If you later deploy on a server (Vercel/Render/etc.), you can add API keys and a backend safely there.

# Public site URL used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://homebuying.ie

# GitHub Pages project sites need a base path, e.g. /homebuying.
NEXT_PUBLIC_BASE_PATH=

# Broker lead capture for GitHub Pages (static): use an external form endpoint.
NEXT_PUBLIC_LEAD_FORM_URL=

# Paid report monetisation (optional): set a Stripe Payment Link / Gumroad product URL + an intake form.
NEXT_PUBLIC_VALUATION_PAYMENT_URL=
NEXT_PUBLIC_VALUATION_INTAKE_URL=
NEXT_PUBLIC_VALUATION_PRICE_LABEL=€2.99

